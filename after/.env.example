PORT=3100
# 生产环境必须设置强密码；缺省 admin123 仅用于本地开发兼容。
ADMIN_PASSWORD=replace-with-a-strong-production-password
# 公共注册默认关闭。仅明确设为 true 时开放 POST /api/auth/register。
ALLOW_PUBLIC_REGISTRATION=false
DEMO_TOKEN=agri-demo-token
DEVICE_KEY=agri-terminal-2026
AGRI_CLOUD_DATA_DIR=./data
APP_UPDATE_VERSION_NAME=1.0.1
APP_UPDATE_VERSION_CODE=103
APP_UPDATE_TYPE=apk
APP_UPDATE_PACKAGE_URL=https://download.example.com/agriculture-1.0.1.apk
APP_UPDATE_TITLE=田间管理 1.0.1
APP_UPDATE_DESCRIPTION=修复已知问题\n优化巡田体验
APP_UPDATE_SIZE=0
APP_UPDATE_SHA256=
APP_UPDATE_MANDATORY=false
APP_UPDATE_PUBLISHED_AT=2026-08-05T00:00:00.000Z
APP_UPDATE_STORE_URL=

# 可按平台覆盖上述任意字段，例如：
APP_UPDATE_IOS_VERSION_NAME=1.0.1
APP_UPDATE_IOS_VERSION_CODE=103
APP_UPDATE_IOS_TYPE=store
APP_UPDATE_IOS_PACKAGE_URL=https://apps.apple.com/app/id0000000000
APP_UPDATE_IOS_STORE_URL=https://apps.apple.com/app/id0000000000
