{
  "name": "fengyu-agriculture-desktop",
  "version": "1.0.0-beta.1",
  "description": "支持离线、局域网与蓝牙接入的农业生产桌面系统",
  "author": "Fengyu Agriculture",
  "private": true,
  "main": "main.cjs",
  "scripts": {
    "dev:server": "npm --prefix server run start:dev",
    "dev:renderer": "npm --prefix renderer run dev",
    "build:server": "npm --prefix server run build",
    "build:renderer": "npm --prefix renderer run build",
    "ensure:electron": "electron --version",
    "dev": "npm run ensure:electron && npm run build:server && concurrently -k \"npm run dev:renderer\" \"wait-on http://127.0.0.1:5173 && electron . --dev\"",
    "build": "npm run ensure:electron && npm run build:server && npm run build:renderer && electron-builder --win nsis --publish never",
    "pack": "npm run ensure:electron && npm run build:server && npm run build:renderer && electron-builder --dir --publish never"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.28",
    "@nestjs/core": "^11.1.28",
    "@nestjs/platform-express": "^11.1.28",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "wait-on": "^9.0.1"
  },
  "build": {
    "appId": "com.fengyu.agriculture",
    "productName": "丰域农业",
    "asar": true,
    "npmRebuild": false,
    "electronDist": "node_modules/electron/dist",
    "directories": {
      "app": ".",
      "output": "release"
    },
    "files": [
      "main.cjs",
      "preload.cjs",
      "server/dist/**/*",
      "renderer/dist/**/*",
      "build/icon.ico",
      "package.json"
    ],
    "win": {
      "icon": "build/icon.ico",
      "artifactName": "Fengyu-Agriculture-Desktop-${version}-${arch}.${ext}",
      "target": ["nsis"]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
