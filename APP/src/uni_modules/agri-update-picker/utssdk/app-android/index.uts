import Activity from 'android.app.Activity'
import Intent from 'android.content.Intent'
import OpenableColumns from 'android.provider.OpenableColumns'
import File from 'java.io.File'
import FileInputStream from 'java.io.FileInputStream'
import FileOutputStream from 'java.io.FileOutputStream'
import Integer from 'java.lang.Integer'
import MessageDigest from 'java.security.MessageDigest'
import { ChooseUpdatePackage, ChooseUpdatePackageOptions, InspectUpdatePackage, InspectUpdatePackageOptions, UpdatePackageFile } from '../interface.uts'

const REQUEST_CODE : Int = 17642
const MAX_PACKAGE_SIZE : Long = 1024 * 1024 * 1024
let activityResultCallback : ((requestCode : Int, resultCode : Int, data ?: Intent) => void) | null = null
let activityDestroyCallback : (() => void) | null = null

function clearActivityCallbacks() : void {
  if (activityResultCallback != null) UTSAndroid.offAppActivityResult(activityResultCallback!)
  if (activityDestroyCallback != null) UTSAndroid.offAppActivityDestroy(activityDestroyCallback!)
  activityResultCallback = null
  activityDestroyCallback = null
}

function reportFailure(options : ChooseUpdatePackageOptions | InspectUpdatePackageOptions, message : string) : void {
  UTSAndroid.getDispatcher('main').async(function (_) {
    options.fail({ errMsg: message })
  }, null)
}

function copySelectedFile(options : ChooseUpdatePackageOptions, data : Intent) : void {
  const activity = UTSAndroid.getUniActivity()
  const uri = data.getData()
  if (activity == null || uri == null) {
    reportFailure(options, '未能读取所选文件')
    return
  }

  UTSAndroid.getDispatcher('io').async(function (_) {
    try {
      const resolver = activity.getContentResolver()
      let displayName = ''
      let declaredSize : Long = 0
      const cursor = resolver.query(uri, null, null, null, null)
      if (cursor != null) {
        try {
          if (cursor.moveToFirst()) {
            const nameIndex = cursor.getColumnIndex(OpenableColumns.DISPLAY_NAME)
            const sizeIndex = cursor.getColumnIndex(OpenableColumns.SIZE)
            if (nameIndex >= 0) {
              const selectedName = cursor.getString(nameIndex)
              if (selectedName != null) displayName = selectedName
            }
            if (sizeIndex >= 0 && !cursor.isNull(sizeIndex)) declaredSize = cursor.getLong(sizeIndex)
          }
        } finally {
          cursor.close()
        }
      }

      const lowerName = displayName.toLowerCase()
      let extension = ''
      if (lowerName.endsWith('.apk')) extension = '.apk'
      if (lowerName.endsWith('.wgt')) extension = '.wgt'
      if (extension.length == 0) {
        reportFailure(options, '只支持 APK 或 WGT 更新包')
        return
      }
      if (declaredSize > MAX_PACKAGE_SIZE) {
        reportFailure(options, '更新包不能超过 1 GB')
        return
      }

      const cacheFiles = activity.getCacheDir().listFiles()
      if (cacheFiles != null) {
        for (file in cacheFiles) {
          if (file.getName().startsWith('agri-update-')) file.delete()
        }
      }

      const input = resolver.openInputStream(uri)
      if (input == null) {
        reportFailure(options, '无法打开所选更新包')
        return
      }
      const outputFile = new File(activity.getCacheDir(), `agri-update-${Date.now()}${extension}`)
      const output = new FileOutputStream(outputFile)
      try {
        const buffer = new ByteArray(64 * 1024)
        let copiedSize : Long = 0
        let length = input.read(buffer)
        while (length > 0) {
          copiedSize += length.toLong()
          if (copiedSize > MAX_PACKAGE_SIZE) throw new Error('更新包不能超过 1 GB')
          output.write(buffer, 0, length)
          length = input.read(buffer)
        }
        output.flush()
      } finally {
        input.close()
        output.close()
      }

      const result : UpdatePackageFile = {
        path: outputFile.getAbsolutePath(),
        name: displayName,
        size: Number.from(declaredSize > 0 ? declaredSize : outputFile.length())
      }
      UTSAndroid.getDispatcher('main').async(function (_) {
        options.success(result)
      }, null)
    } catch (error) {
      reportFailure(options, `读取更新包失败：${error}`)
    }
  }, null)
}

export const chooseUpdatePackage : ChooseUpdatePackage = function (options : ChooseUpdatePackageOptions) {
  const activity = UTSAndroid.getUniActivity()
  if (activity == null) {
    options.fail({ errMsg: '当前页面不可用' })
    return
  }
  if (activityResultCallback != null) {
    options.fail({ errMsg: '文件选择器正在运行' })
    return
  }

  activityResultCallback = (requestCode : Int, resultCode : Int, data ?: Intent) => {
    if (requestCode != REQUEST_CODE) return
    clearActivityCallbacks()
    if (resultCode != Activity.RESULT_OK || data == null) {
      options.fail({ errMsg: '已取消选择' })
      return
    }
    copySelectedFile(options, data)
  }
  UTSAndroid.onAppActivityResult(activityResultCallback!)
  activityDestroyCallback = () => {
    clearActivityCallbacks()
  }
  UTSAndroid.onAppActivityDestroy(activityDestroyCallback!)

  try {
    const intent = new Intent(Intent.ACTION_OPEN_DOCUMENT)
    intent.addCategory(Intent.CATEGORY_OPENABLE)
    intent.setType('*/*')
    activity.startActivityForResult(Intent.createChooser(intent, '选择更新包'), REQUEST_CODE)
  } catch (error) {
    clearActivityCallbacks()
    options.fail({ errMsg: `无法打开文件选择器：${error}` })
  }
}

export const inspectUpdatePackage : InspectUpdatePackage = function (options : InspectUpdatePackageOptions) {
  UTSAndroid.getDispatcher('io').async(function (_) {
    try {
      const file = new File(options.path)
      if (!file.exists() || !file.isFile()) {
        reportFailure(options, '安装包不存在')
        return
      }
      if (file.length() > MAX_PACKAGE_SIZE) {
        reportFailure(options, '更新包不能超过 1 GB')
        return
      }

      const digest = MessageDigest.getInstance('SHA-256')
      const input = new FileInputStream(file)
      try {
        const buffer = new ByteArray(64 * 1024)
        let length = input.read(buffer)
        while (length > 0) {
          digest.update(buffer, 0, length)
          length = input.read(buffer)
        }
      } finally {
        input.close()
      }

      let sha256 = ''
      for (item in digest.digest()) {
        const part = Integer.toHexString(item.toInt() & 255)
        if (part.length == 1) sha256 += '0'
        sha256 += part
      }
      const size = Number.from(file.length())
      UTSAndroid.getDispatcher('main').async(function (_) {
        options.success({ size, sha256 })
      }, null)
    } catch (error) {
      reportFailure(options, `校验更新包失败：${error}`)
    }
  }, null)
}
